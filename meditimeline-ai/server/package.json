{
  "name": "meditimeline-ai-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.5.0",
    "helmet": "^8.0.0",
    "meditimeline-ai": "file:..",
    "multer": "^1.4.5-lts.1",
    "otplib": "^13.5.0",
    "prisma": "^5.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.5.0",
    "@types/multer": "^1.4.5",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
